# Loaded automatically by Vite — no extra flag needed to start the mock env.
#
#   npm run dev:mock
#
# The URL below is what the deployed frontend calls. The mock adapter replaces
# the transport entirely, so this value is only read for the request-log
# display — but keeping it accurate means the log shows the URL a real
# deployment would use.
#
# Copy this file to `.env.local` instead if you want to override the API base
# URL for real-backend testing without editing a tracked file. Set
# VITE_USE_MOCKS=false there to hit the real backend locally.
VITE_API_BASE_URL=https://sukuupay-backend.onrender.com/api
VITE_USE_MOCKS=true
