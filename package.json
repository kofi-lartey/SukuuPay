{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "build:mock": "vite build --mode mock",
    "test": "node --test \"src/**/*.test.js\" && node check-netlify-csp.mjs && npm run test:render && npm run test:auth",
    "test:render": "vite build --config .mockcheck/vite.config.js --ssr .mockcheck/overview-cards.jsx --outDir .mockcheck/out-cards --emptyOutDir --logLevel error && node .mockcheck/run-cards.mjs",
    "test:auth": "vite build --config .mockcheck/vite.config.js --ssr .mockcheck/auth-pages-render.jsx --outDir .mockcheck/out-auth2 --emptyOutDir --logLevel error && node .mockcheck/run-auth-pages.mjs",
    "test:console": "vite build --config .mockcheck/vite.config.js --ssr .mockcheck/console-render.jsx --outDir .mockcheck/out-console --emptyOutDir --logLevel error && node .mockcheck/run-console-render.mjs",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "preview:mock": "vite preview --mode mock",
    "check:mock": "vite build --config .mockcheck/vite.config.js --ssr .mockcheck/entry.js --outDir .mockcheck/out --emptyOutDir --logLevel error && node .mockcheck/run.mjs",
    "check:auth": "vite build --config .mockcheck/vite.config.js --ssr .mockcheck/auth-render.jsx --outDir .mockcheck/out-auth --emptyOutDir --logLevel error && node .mockcheck/run-auth-render.mjs",
    "check:dashboard": "vite build --config .mockcheck/vite.config.js --ssr .mockcheck/dashboard-render.jsx --outDir .mockcheck/out-dashboard --emptyOutDir --logLevel error && node .mockcheck/run-dashboard-render.mjs",
    "check:admin": "vite build --config .mockcheck/vite.config.js --ssr .mockcheck/admin-render.jsx --outDir .mockcheck/out-admin --emptyOutDir --logLevel error && node .mockcheck/run-admin-render.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "axios": "^1.6.0",
    "lucide-react": "^1.48.0",
    "papaparse": "^5.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.20.0",
    "socket.io-client": "^4.8.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.14",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "esbuild": "^0.20.2",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.8"
  }
}
