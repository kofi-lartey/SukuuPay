# Frontend environment.
#
# Copy to `.env.local` (git-ignored) and adjust. `.env` is committed defaults;
# Vite reads `.env.local` first, then `.env`.

# Base URL of the SukuuPay API. The server mounts its routes under `/api`, so
# the prefix belongs here. Ignored when VITE_USE_MOCKS is true — the mock
# adapter replaces the transport entirely, but the value is still read for
# request-log display.
VITE_API_BASE_URL=https://sukuupay-backend.onrender.com/api

# ── Mock environment ───────────────────────────────────────────────────────
# Set to "true" to serve every /api request from src/mocks instead of the
# network. See src/mocks/README.md.
#
# This ships the mock code as a lazily-loaded chunk. Leave it "false" in any
# deployed build: the fixtures include invented students, parents and SMS
# content, and a production bundle that can switch into them is a liability
# rather than a feature.
VITE_USE_MOCKS=false
