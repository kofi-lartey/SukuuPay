# Frontend environment.
#
# Copy to `.env.local` (git-ignored) and adjust. `.env` is committed defaults;
# Vite reads `.env.local` first, then `.env`.

# Base URL of the SukuuPay API. The server mounts its routes under `/api`, so
# the prefix belongs here. Ignored when VITE_USE_MOCKS is true — the mock
# adapter replaces the transport entirely, but the value is still read for
# request-log display.
VITE_API_BASE_URL=https://sukuupay-backend.onrender.com/api

# ── Google Sign-In ───────────────────────────────────────────────────────────
# The OAuth 2.0 **Web application** client ID from Google Cloud console →
# Credentials. NOT the API key and NOT the client secret.
#
# Not a secret — it ships to every browser. What it controls is which origin the
# resulting token is minted for, and the API refuses any token whose audience is not
# this exact value. It must be the SAME value as the backend's GOOGLE_CLIENT_ID; if
# they differ, every sign-in fails on the audience check.
#
# Leave empty to keep the feature off: the login page hides the button and does not
# load Google's script at all. It also has to match GOOGLE_ALLOWED_ORIGINS on the
# backend, or the request is refused before the token is even read.
VITE_GOOGLE_CLIENT_ID=262307940383-i7bg334rl8c3mggavqaj3o74f8991rsn.apps.googleusercontent.com

# ── Mock environment ───────────────────────────────────────────────────────
# Set to "true" to serve every /api request from src/mocks instead of the
# network. See src/mocks/README.md.
#
# This ships the mock code as a lazily-loaded chunk. Leave it "false" in any
# deployed build: the fixtures include invented students, parents and SMS
# content, and a production bundle that can switch into them is a liability
# rather than a feature.
VITE_USE_MOCKS=false
